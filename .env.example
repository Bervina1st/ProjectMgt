# Environment variables for PM Status Autopilot / Statuscope.
# NAMES ONLY — never commit real values. Copy to `.env` (gitignored) for local dev,
# and set them in the platform stores (Netlify for the web app, Railway for the worker).
#
# NOTE: the current frontend MVP (apps/web) needs NONE of these — it's client-side only.
# These are for the real backend (roadmap M1+). Project: my-statuscope-app.

# --- Public (safe in the browser; set in Netlify) ---
# Values for my-statuscope-app live in the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # the sb_publishable_... key

# --- Server-only secrets (NEVER expose to the client or commit) ---
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                        # Postgres connection string (worker / pg-boss)
ANTHROPIC_API_KEY=
TOKEN_ENCRYPTION_KEY=                # for encrypting per-tenant OAuth tokens

# --- Provider OAuth (roadmap M2) ---
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
